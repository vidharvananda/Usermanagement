# Copy to .env and fill in. Never commit .env.

# --- Login: use either mobile OTP or email/password ---

# Mobile OTP (recommended if the shop uses phone login). You will be prompted for the OTP
# in the terminal when it arrives (e.g. on your Mac via iPhone Messages), unless RCB_OTP is set.
RCB_MOBILE=+91XXXXXXXXXX

# Optional: supply OTP non-interactively (e.g. export RCB_OTP=123456 right before login-once).
# Do not commit a real OTP to git.
RCB_OTP=
# Try reading OTP automatically from Mac Messages database (requires Full Disk Access for terminal/Node).
RCB_AUTO_OTP=false
# Regex used to extract OTP digits from message text.
RCB_OTP_REGEX=\b\d{4,8}\b
# Optional message hint (e.g. RCB, Royal, one-time password) to avoid wrong OTP matches.
RCB_OTP_TEXT_HINT=
# How long to wait for auto OTP.
RCB_OTP_TIMEOUT_SEC=75
# Poll interval while waiting for OTP.
RCB_OTP_POLL_SEC=2

RCB_EMAIL=you@example.com
RCB_PASSWORD=your_password

# How often to reload and check (seconds)
POLL_INTERVAL_SEC=60

# Playwright: "true" shows the browser (helpful for first-time login / debugging)
HEADLESS=true

# --- Availability detection (pick one approach) ---

# If set, notification fires when this Playwright selector matches at least one element.
# Examples (adjust after you inspect the live page in DevTools):
#   text=Book Now
#   a:has-text("Buy")
#   [data-testid="ticket-cta"]
AVAILABILITY_SELECTOR=

# If AVAILABILITY_SELECTOR is empty, we treat tickets as available when the page body
# matches this case-insensitive regex (e.g. button labels). Empty = disabled.
AVAILABILITY_TEXT_REGEX=Book Now|Buy Tickets|Purchase|Select seats

# Optional: if this selector is visible, we assume tickets are NOT on sale yet (guards false positives)
BLOCKED_SELECTOR=text=Sold Out

# Optional: if this selector is visible, we assume tickets are NOT on sale yet
BLOCKED_TEXT_REGEX=coming soon|sold out|unavailable|no tickets
